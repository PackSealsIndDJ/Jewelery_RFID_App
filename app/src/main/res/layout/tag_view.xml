<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/tag_index"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.35"
        android:gravity="center"
        android:textColor="@color/muted_ink"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tag_epc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:gravity="start|center_vertical"
        android:maxLines="1"
        android:textColor="@color/ink"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tag_encoded_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:gravity="start|center_vertical"
        android:maxLines="1"
        android:textColor="@color/ink"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tag_rssi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.45"
        android:gravity="center"
        android:textColor="@color/ink"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tag_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.4"
        android:gravity="center"
        android:textColor="@color/ink"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tag_first_scan_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.75"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/muted_ink"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/tag_last_scan_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.75"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/muted_ink"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/tag_tid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tag_user"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tag_reserved"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
