<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inventory_overview_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/inventory_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/inventory_heading"
        android:textColor="@color/ink"
        android:textSize="21sp" />

    <TextView
        android:id="@+id/inventory_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/inventory_subtitle"
        android:textColor="@color/muted_ink"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/inventory_metrics"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/inventory_metrics_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inventory_total_label"
                android:textColor="@color/muted_ink"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tagTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="0"
                android:textColor="@color/ink"
                android:textSize="21sp" />
        </LinearLayout>

        <View
            android:id="@+id/inventory_speed_divider"
            android:layout_width="1dp"
            android:layout_height="38dp"
            android:background="@color/line" />

        <LinearLayout
            android:id="@+id/inventory_speed_metric"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inventory_speed_label"
                android:textColor="@color/muted_ink"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tagSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="—"
                android:textColor="@color/ink"
                android:textSize="18sp" />
        </LinearLayout>

        <View
            android:id="@+id/inventory_time_divider"
            android:layout_width="1dp"
            android:layout_height="38dp"
            android:background="@color/line" />

        <LinearLayout
            android:id="@+id/inventory_time_metric"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inventory_time_label"
                android:textColor="@color/muted_ink"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tagReadTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="—"
                android:textColor="@color/ink"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tagDisplaySummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/inventory_tag_display_summary_initial"
            android:textColor="@color/muted_ink"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/inventory_expand_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/inventory_expand_list"
            android:padding="12dp"
            android:scaleType="center"
            android:src="@drawable/ic_expand_more"
            android:tint="@color/teal_primary" />
    </LinearLayout>
</LinearLayout>
