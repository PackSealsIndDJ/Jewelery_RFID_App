<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bind_item_epc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/layer"
            android:layout_weight="2"
            android:textSize="@dimen/text_size_16"
            android:text="@string/bind_tag_id_header"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/bind_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/layer"
            android:textSize="@dimen/text_size_16"
            android:layout_weight="1"
            android:text="@string/goods_table_title"
            android:textAlignment="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/layer"
            android:text="@string/find_tag_status"
            android:textAlignment="center"
            android:textSize="@dimen/text_size_16" />
    </LinearLayout>

    <com.pda.uhfdemo.view.RadarView
        android:id="@+id/find_radar"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_margin="8dp"
        android:background="@color/white" />

    <TextView
        android:id="@+id/find_radar_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/radar_select_target" />

    <TextView
        android:id="@+id/find_radar_distance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/radar_distance_unknown" />

    <TextView
        android:id="@+id/find_radar_trend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/radar_waiting" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/find_listview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2"
        android:orientation="horizontal">

        <Button
            android:id="@+id/find_export"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:drawableStart="@android:drawable/ic_menu_save"
            android:enabled="false"
            android:text="@string/export_csv"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/find_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:textAllCaps="false"
            android:text="@string/scan_btn" />
    </LinearLayout>


</LinearLayout>